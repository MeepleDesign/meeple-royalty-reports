# Supabase (see SETUP.md step 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Google OAuth (see SETUP.md step 2) — authorizes the app as your own
# Google account, not a service account. Two separate refresh tokens
# (one per API), since that's what reliably comes out of the OAuth
# Playground.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SHEETS_REFRESH_TOKEN=
GOOGLE_OAUTH_DRIVE_REFRESH_TOKEN=
ROYALTY_ROOT_FOLDER_ID=

# App
# Email/password of the single allowed user (your Supabase Auth login)
APP_OWNER_EMAIL=boardgames@meepledesign.com
